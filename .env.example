# Copy to .env; never commit real API keys.
AITUNNEL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
HERMES_TELEGRAM_OIDC_CLIENT_ID=
HERMES_TELEGRAM_OIDC_CLIENT_SECRET=
# When set, email login replaces Telegram OAuth. Telegram ID stays linked to the account.
HERMES_LOGIN_EMAIL=
HERMES_SMTP_HOST=
HERMES_SMTP_PORT=
HERMES_SMTP_SECURE=true
HERMES_SMTP_USER=
HERMES_SMTP_PASSWORD=
HERMES_SMTP_FROM=
