[Unit]
Description=Local embeddings for Hermes Chronicle
After=network-online.target
Wants=network-online.target

[Service]
User=hermes-ollama
Group=hermes-ollama
StateDirectory=hermes-ollama
StateDirectoryMode=0700
Environment=HOME=/var/lib/hermes-ollama
Environment=OLLAMA_MODELS=/var/lib/hermes-ollama/models
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_KEEP_ALIVE=10s
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=4
Environment=OLLAMA_NO_CLOUD=1
ExecStart=/opt/hermes-ollama/bin/ollama serve
Restart=on-failure
RestartSec=10
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hermes-ollama

[Install]
WantedBy=multi-user.target
