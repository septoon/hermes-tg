[Unit]
Description=Hermes Agent gateway (AITunnel)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/hermes-tg
Environment=HOME=/home/hermes
ExecStart=/home/hermes/hermes-tg/hermes gateway run --external-supervisor
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes
CPUQuota=100%
MemoryHigh=512M
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
